{
  "name": "unshit",
  "version": "0.2.0",
  "description": "Open-source codebase detox CLI: deterministic dead-code, clone, CSS, i18n, and AI-slop scanner + gated AI fixer.",
  "type": "module",
  "license": "MIT",
  "author": "Mohamed Ashraf (Crewloom)",
  "homepage": "https://github.com/crewloom/unshit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crewloom/unshit.git"
  },
  "bugs": {
    "url": "https://github.com/crewloom/unshit/issues"
  },
  "bin": {
    "unshit": "bin/unshit.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/contracts.d.ts",
      "import": "./dist/src/core/scanner.js"
    }
  },
  "files": [
    "bin",
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:pkg": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build:pkg",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "unshit": "node ./bin/unshit.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "typescript": "^5.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "cleanup",
    "linter",
    "dead-code",
    "ai-slop",
    "refactoring",
    "cli",
    "mcp"
  ]
}
